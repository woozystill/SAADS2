<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>encoder_driver</name>

  <version>0.0.0</version>

  <description>
    Wheel encoder and odometry driver for the SAADS vehicle.
    Reads four wheel velocities from the motor controller over I2C
    and publishes ROS 2 wheel odometry.
  </description>

  <maintainer email="saads@todo.todo">
    saads
  </maintainer>

  <license>TODO</license>


  <!-- ===================================================== -->
  <!-- RUNTIME DEPENDENCIES -->
  <!-- ===================================================== -->

  <exec_depend>rclpy</exec_depend>

  <exec_depend>nav_msgs</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>

  <exec_depend>python3-smbus2</exec_depend>


  <!-- ===================================================== -->
  <!-- TEST DEPENDENCIES -->
  <!-- ===================================================== -->

  <test_depend>ament_copyright</test_depend>

  <test_depend>ament_flake8</test_depend>

  <test_depend>ament_pep257</test_depend>

  <test_depend>python3-pytest</test_depend>


  <!-- ===================================================== -->
  <!-- BUILD TYPE -->
  <!-- ===================================================== -->

  <export>

    <build_type>ament_python</build_type>

  </export>

</package>
